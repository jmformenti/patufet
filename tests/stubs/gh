#!/usr/bin/env bash
# Stub of the GitHub CLI for the offline tests. Every call is appended to
# $GH_STUB_LOG; answers come from the fixture files named by GH_STUB_* variables.
set -euo pipefail
echo "gh $*" >> "${GH_STUB_LOG:-/dev/null}"

case "$1 ${2:-}" in
  "api repos/"*)
    case "$2" in
      */issues/*/comments) cat "${GH_STUB_ISSUE_COMMENTS:?}" ;;
      */pulls/*/comments)  cat "${GH_STUB_PR_COMMENTS:?}" ;;
      */actions/runs/*/jobs*)
        # GH_STUB_JOBS_DIR/<run id>.json; a missing file is an error, like an unreadable run
        id=${2#*/actions/runs/}; id=${id%%/*}
        cat "${GH_STUB_JOBS_DIR:?}/$id.json" ;;
      */actions/runs\?*)
        # GH_STUB_WORKFLOW_RUNS: colon-separated fixtures, one per poll; the last one repeats
        if [ -n "${GH_STUB_WORKFLOW_RUNS_ERROR:-}" ]; then echo "$GH_STUB_WORKFLOW_RUNS_ERROR" >&2; exit 1; fi
        IFS=: read -ra polls <<< "${GH_STUB_WORKFLOW_RUNS:?}"
        n=$(grep -c 'actions/runs?' "${GH_STUB_LOG:?}")
        [ "$n" -le "${#polls[@]}" ] || n=${#polls[@]}
        cat "${polls[$((n - 1))]}" ;;
      */actions/jobs/*/logs)
        if [ -n "${GH_STUB_JOB_LOG_ERROR:-}" ]; then echo "$GH_STUB_JOB_LOG_ERROR" >&2; exit 1; fi
        # Like the real gh: recent versions need the flag for a log with colours,
        # older ones (GH_STUB_OLD_GH) do not know it
        if [ -n "${GH_STUB_OLD_GH:-}" ]; then
          if [ "${3:-}" = --allow-escape-sequences ]; then echo "unknown flag: --allow-escape-sequences" >&2; exit 1; fi
        elif [ "${3:-}" != --allow-escape-sequences ]; then
          echo "the response contains terminal escape sequences; pass --allow-escape-sequences to output it anyway" >&2; exit 1
        fi
        cat "${GH_STUB_JOB_LOG:?}" ;;
      *) echo "gh stub: unexpected api path $2" >&2; exit 1 ;;
    esac ;;
  "pr view")     cat "${GH_STUB_PR_VIEW:?}" ;;
  "pr edit")     : ;;
  "repo view")   echo "octo/app" ;;
  "label list")  printf '%s' "${GH_STUB_LABELS:-}" ;;
  "label create") [ -z "${GH_STUB_LABEL_CREATE_FAILS:-}" ] || exit 1 ;;
  "secret list") printf '%s' "${GH_STUB_SECRETS:-}" ;;
  *) echo "gh stub: unexpected call: gh $*" >&2; exit 1 ;;
esac
